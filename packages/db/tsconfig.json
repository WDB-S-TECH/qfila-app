{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "module": "Preserve",
    "moduleResolution": "Bundler"
  },
  "baseUrl": ".",
  "paths": {
    "#/*": ["src/*"]
  },
  "include": ["src", "drizzle.config.ts"],
  "exclude": ["node_modules", "src/seed"]
}
