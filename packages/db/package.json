{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf .turbo node_modules",
    "generate": "pnpm with-env drizzle-kit generate",
    "migrate": "supabase migration up",
    "generate-custom": "pnpm with-env drizzle-kit generate --custom",
    "introspect": "pnpm with-env drizzle-kit introspect",
    "drop": "pnpm with-env drizzle-kit drop",
    "check": "pnpm with-env drizzle-kit check",
    "push": "pnpm with-env drizzle-kit push",
    "studio": "pnpm with-env drizzle-kit studio",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "@vercel/postgres": "^0.9.0",
    "arktype": "catalog:",
    "dayjs": "catalog:",
    "drizzle-orm": "catalog:drizzle",
    "drizzle-seed": "catalog:drizzle",
    "drizzle-zod": "catalog:drizzle",
    "drizzle-arktype": "catalog:drizzle",
    "nanoid": "^5.1.0",
    "pg": "^8.13.3",
    "postgres": "^3.4.5",
    "uuid": "^10.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@repo/typescript-config": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "@types/bcrypt": "^5.0.2",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.1",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "catalog:drizzle",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
