{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "funcs": "./src/funcs/index.ts",
      "default": "./src/index.ts"
    },
    "./funcs": {
      "types": "./dist/funcs.d.ts",
      "default": "./src/funcs/index.ts"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./src/schemas/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf .turbo node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@trpc/server": "catalog:trpc",
    "dayjs": "catalog:",
    "next": "catalog:next15",
    "react": "catalog:react19",
    "resend": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:node",
    "@types/react": "catalog:react19",
    "@vitest/ui": "^1.2.0",
    "typescript": "catalog:",
    "vitest": "^1.2.0"
  },
  "overrides": {
    "react": "catalog:react18"
  }
}
