{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "//#format-and-lint": {},
    "//#format-and-lint:fix": {},
    "//#format-and-lint:fix:all": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": [
    "**/.env"
  ],
  "globalEnv": [
    "POSTGRES_URL"
  ]
}