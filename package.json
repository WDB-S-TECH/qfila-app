{
  "name": "qfila",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start:web": "turbo run start --filter=web",
    "typecheck": "turbo run typecheck",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "format-and-lint:fix:all": "biome check . --write --unsafe"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "^2.4.4",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.7.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
